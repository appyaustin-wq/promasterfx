rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (Default Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper function to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if user is an administrator
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if user owns document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User documents
    match /users/{userId} {
      allow read, write: if true;
    }

    // Demo Markets catalog
    match /markets/{marketId} {
      allow read, list: if true;
      allow write: if true;
    }

    // User Watchlists
    match /watchlists/{id} {
      allow read, write: if true;
    }

    // User Orders
    match /orders/{id} {
      allow read, write: if true;
    }

    // User Positions
    match /positions/{id} {
      allow read, write: if true;
    }

    // User Activities
    match /activities/{id} {
      allow read, write: if true;
    }

    // Admin Audit Logs (Immutable)
    match /auditLogs/{id} {
      allow read, write: if true;
    }

    // Platform Settings
    match /platformSettings/{id} {
      allow read, write: if true;
    }

    // Deposit Requests
    match /depositRequests/{id} {
      allow read, write: if true;
    }

    // Withdrawal Requests
    match /withdrawalRequests/{id} {
      allow read, write: if true;
    }

    // Admin-Generated Withdrawal Authorization Codes
    match /withdrawalCodes/{codeId} {
      allow read, write: if true;
    }

    // Loan Requests
    match /loanRequests/{id} {
      allow read, write: if true;
    }

    // Payment Methods Configuration
    match /paymentMethods/{id} {
      allow read, write: if true;
    }

    // Live Support Chat Threads
    match /supportThreads/{userId} {
      allow read, write: if true;
    }

    // In-App System and Transaction Notifications
    match /notifications/{id} {
      allow read, write: if true;
    }

    // Admin Broadcast Logs
    match /broadcasts/{id} {
      allow read, write: if true;
    }
  }
}

